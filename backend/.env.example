# Configuración del Entorno
NODE_ENV=development
AWS_REGION=us-east-1
STAGE=academic

# Tablas DynamoDB
PROJECTS_TABLE=Projects
DONATIONS_TABLE=Donations
IDEMPOTENCY_TABLE=Idempotency
