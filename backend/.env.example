# Almacenamiento S3
S3_BUCKET=secure-donations-assets-bucket

# Amazon Cognito 
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

LOG_LEVEL=info