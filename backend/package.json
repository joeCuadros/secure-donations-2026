{
  "name": "secure-donations-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend Serverless para Plataforma de Donaciones Seguras 2026",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/**/*.ts --outdir=dist --bundle --platform=node --target=node24 --format=esm --sourcemap && node -e \"fs.writeFileSync('dist/package.json', '{\\\"type\\\":\\\"module\\\"}')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "aws",
    "serverless",
    "lambda",
    "dynamodb",
    "zero-trust",
    "typescript"
  ],
  "author": "UNSA - Tópicos Avanzados en Ingeniería de Software",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1163.0",
    "@aws-sdk/client-dynamodb": "^3.1163.0",
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/lib-dynamodb": "^3.1163.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
