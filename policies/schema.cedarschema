namespace SecureDonations {
  entity User in [UserGroup] {
    sub: String,
    email?: String
  };

  entity UserGroup;

  entity Project {
    status?: String
  };

  entity Donation {
    donorSub: String,
    status?: String
  };

  entity AuditLog;

  action "CreateProject" appliesTo {
    principal: User,
    resource: Project
  };

  action "PublishProject" appliesTo {
    principal: User,
    resource: Project
  };

  action "CreateDonation" appliesTo {
    principal: User,
    resource: Project
  };

  action "SimulateDonation" appliesTo {
    principal: User,
    resource: Donation
  };

  action "ReadMyDonations" appliesTo {
    principal: User,
    resource: Donation
  };

  action "ReadAuditLogs" appliesTo {
    principal: User,
    resource: AuditLog
  };
}